// Replacement entry point for the stock Dolby Codec2 service binary.
//
// The module is deliberately named without '@' and uses `stem` so the installed
// path stays /vendor/bin/hw/vendor.dolby.media.c2@1.0-service, which keeps the
// existing init rc, VINTF fragment and SELinux file_contexts untouched.
cc_binary {
    name: "vendor.dolby.media.c2-service",
    stem: "vendor.dolby.media.c2@1.0-service",

    vendor: true,
    relative_install_path: "hw",
    compile_multilib: "64",

    srcs: [
        "service.cpp",
    ],

    shared_libs: [
        "android.hardware.media.c2@1.0",
        "libbase",
        "libbinder",
        "libcodec2_hidl@1.0",
        "libcodec2_vndk",
        "libhidlbase",
        "liblog",
        "libutils",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],
}
