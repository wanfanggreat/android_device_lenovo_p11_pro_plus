<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Phase 2B：防误触唤醒（Prevent accidental wake-up）。
      PowerManagerService 读这两个值；设备有 tmf8801 距离传感器。
    -->
    <bool name="config_proximityCheckOnWake">true</bool>
    <bool name="config_proximityCheckOnWakeEnabledByDefault">true</bool>

    <!--
      Phase 3B：电池灯。硬件是 red/green/blue 三颗 LED（都有 breath 节点），
      QTI lights HAL 在跑。202 = RGB 电池灯(2) + 呼吸(8) + 电池灯(64) + 可调亮度(128)。
      先只做电池灯；通知灯(235)等实测无冲突再开。
    -->
    <integer name="config_deviceLightCapabilities">202</integer>
</resources>
