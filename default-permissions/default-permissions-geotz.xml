<!--
     F5: the AOSP offline location time zone provider is a priv-app with no UI,
     so nobody can grant it the runtime location permissions. privapp-permissions
     only covers privileged permissions; dangerous permissions need this
     default-permissions grant, otherwise LocationManager.getCurrentLocation()
     throws SecurityException and the provider process crash-loops.
-->
<exceptions>
    <exception package="com.android.timezone.location.provider">
        <permission name="android.permission.ACCESS_COARSE_LOCATION" fixed="false"/>
        <permission name="android.permission.ACCESS_FINE_LOCATION" fixed="false"/>
        <permission name="android.permission.ACCESS_BACKGROUND_LOCATION" fixed="false"/>
    </exception>
</exceptions>
