// Standalone HIDL Keymaster 4.1 diagnostic probe (P2-A-1).
// Not installed in any image by default; build with `m km41_probe` and push
// the binary to /data/local/tmp. See km41_probe.cpp for usage.
cc_binary {
    name: "km41_probe",
    srcs: ["km41_probe.cpp"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
    shared_libs: [
        "android.hardware.gatekeeper@1.0",
        "android.hardware.keymaster@4.0",
        "android.hardware.keymaster@4.1",
        "android.hidl.manager@1.0",
        "libbase",
        "libhidlbase",
        "libkeymaster4support",
        "libkeymaster4_1support",
        "liblog",
        "libutils",
    ],
}

// Exercises the running keystore2 service chain (IKeystoreService ->
// IKeystoreSecurityLevel.generateKey / convertStorageKeyToEphemeral).
// Build with `m keystore2_probe` and push the binary to /data/local/tmp.
cc_binary {
    name: "keystore2_probe",
    defaults: ["keystore2_use_latest_aidl_ndk_shared"],
    srcs: ["keystore2_probe.cpp"],
    include_dirs: [
        "hardware/interfaces/security/keymint/support/include",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
    shared_libs: [
        "android.hardware.security.keymint-V5-ndk",
        "libbase",
        "libbinder_ndk",
        "libkeymint_support",
        "liblog",
    ],
    installable: false,
}

// Exercises the real AOSP km_compat conversion path
// (KeyMintDevice::createKeyMintDevice(TEE)) in an isolated process.
// Build with `m kmcompat_probe` and push to /data/local/tmp.
cc_binary {
    name: "kmcompat_probe",
    defaults: ["keymint_use_latest_hal_aidl_ndk_shared"],
    srcs: ["kmcompat_probe.cpp"],
    include_dirs: [
        "hardware/interfaces/security/keymint/support/include",
        "system/security/keystore2/src/km_compat",
        "system/security/keystore2/src/crypto/include",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
    shared_libs: [
        "android.hardware.gatekeeper@1.0",
        "android.hardware.keymaster@3.0",
        "android.hardware.keymaster@4.0",
        "android.hardware.keymaster@4.1",
        "android.hardware.security.secureclock-V1-ndk",
        "android.hardware.security.sharedsecret-V1-ndk",
        "android.security.compat-ndk",
        "libbase",
        "libbinder_ndk",
        "libcrypto",
        "libhidlbase",
        "libkeymaster4_1support",
        "libkm_compat",
        "libutils",
    ],
}
